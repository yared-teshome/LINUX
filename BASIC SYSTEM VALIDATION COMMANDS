# ============================================================
# RED HAT LINUX - BASIC SYSTEM VALIDATION
# Network | Disk | Memory | Archive
# ============================================================


# ============================================================
# NETWORK - READ-ONLY
# ============================================================

# Display network interfaces and assigned IP addresses
ip addr show

# Display network interface state
ip link show

# Display routing table and default gateway
ip route

# Display DNS configuration
cat /etc/resolv.conf

# Display listening TCP/UDP ports and associated processes
ss -tulpn

# Display NetworkManager device status
nmcli device status


# ============================================================
# DISK / STORAGE - READ-ONLY
# ============================================================

# Display filesystem capacity and available space
df -h

# Display filesystem type, capacity, and available space
df -Th

# Display disks, partitions, sizes, filesystem types, and mount points
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT

# Display filesystem UUID and filesystem type information
blkid

# Display currently mounted filesystems
mount

# Display disk usage for directories at the current location
du -sh ./* 2>/dev/null


# ============================================================
# MEMORY - READ-ONLY
# ============================================================

# Display total, used, available memory, and swap
free -h

# Display detailed kernel memory information
cat /proc/meminfo

# Display CPU, memory, processes, and system load
top

# Display virtual memory statistics
# Collect 5 samples at 1-second intervals
vmstat 1 5

# Display top memory-consuming processes
ps aux --sort=-%mem | head -20


# ============================================================
# ARCHIVE - VERBOSE
# ============================================================

# Display size of the source directory before archiving
du -sh /path/to/source

# Display available filesystem space at the archive destination
df -h /path/to/destination

# Create a gzip-compressed archive with verbose output
# c = Create archive
# z = gzip compression
# v = Verbose output - displays each file being processed
# f = Specify archive filename
tar -czvf /path/to/destination/archive.tar.gz /path/to/source

# Confirm the archive was created and display its size
ls -lh /path/to/destination/archive.tar.gz

# Display archive contents with verbose output WITHOUT extracting
tar -tzvf /path/to/destination/archive.tar.gz

# Validate that the archive can be read WITHOUT extracting
tar -tzf /path/to/destination/archive.tar.gz > /dev/null

# Display the result from the validation command
# 0 = Successful
echo $?

# Generate SHA-256 checksum for integrity validation
sha256sum /path/to/destination/archive.tar.gz
